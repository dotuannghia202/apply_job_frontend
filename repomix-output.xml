                <p className="text-xs uppercase text-muted-foreground">
                  {t("myCVManagement.detail.metadata.email")}
                </p>
                <p className="text-foreground">
                  {resume.candidate?.email ??
                    t("myCVManagement.detail.fallbacks.notSpecified")}
                </p>
              </div>
              <div>
                <p className="text-xs uppercase text-muted-foreground">
