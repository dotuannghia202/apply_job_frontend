    ? t("myApplications.detail.ai.matchedSkills")
    : t("employerApplications.aiFit.matchedSkills", "Kỹ năng phù hợp");

  const missingSkillsTitle = isCandidate
    ? t("myApplications.detail.ai.missingSkills")
