  onSubmit: (name: string) => void;
  onClose: () => void;
}

export default function IndustryFormModal({
  open,
  initialData,
  isPending,
  onSubmit,
  onClose,
}: IndustryFormModalProps) {
  const { t } = useTranslation();
  const [name, setName] = useState("");

  const isEdit = !!initialData;

